# Single password for /admin access
NUXT_APP_PASSWORD=change-me

# 32-byte hex secret for signing session cookies
# Generate with: openssl rand -hex 32
NUXT_SESSION_SECRET=replace-with-openssl-rand-hex-32

# The NUXT_ prefix makes these runtime config overrides, read when the server
# starts. The unprefixed APP_PASSWORD / SESSION_SECRET also work, but only if
# present at build time (see README, "How the env vars are read").
